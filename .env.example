# CallBot CRM Environment Configuration Template
# ========================================
# Copy this file to .env.local and fill in your values
# ========================================

# ========================================
# BRANDING
# ========================================
NEXT_PUBLIC_BRAND_NAME=GJ SpaCes
NEXT_PUBLIC_BRAND_TAGLINE=Premium Co-Working & Interior Design
NEXT_PUBLIC_BRAND_LOGO_URL=https://gjspaces.com/wp-content/uploads/2025/11/cropped-1000015092-removebg-preview.png
NEXT_PUBLIC_BRAND_WEBSITE=https://gjspaces.com

# ========================================
# APP CONFIG
# ========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ========================================
# DATABASE (MongoDB Atlas)
# ========================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/callbot-crm

# ========================================
# AI ENGINES & VOICE
# ========================================
# 1. Sarvam AI (Primary Studio Voice TTS Bulbul v3 & Multilingual AI Brain)
SARVAM_API_KEY=your_sarvam_api_key_here

# 2. Groq (Primary Ultra-fast Sub-200ms LLM & Whisper STT)
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenRouter (Silent Fallback LLM — Gemini 2.0 Flash)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ========================================
# TELEPHONY (Twilio)
# ========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ========================================
# ADMIN AUTHENTICATION
# ========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@gjspaces
ADMIN_SESSION_SECRET=your_super_secret_session_key_here
